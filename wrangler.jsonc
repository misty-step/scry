{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scry",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  "main": "target/cloudflare/bundle/worker/index.js",
  "compatibility_date": "2026-09-06",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scry"] }],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "SCRY", "class_name": "Scry" }] },
  "r2_buckets": [{ "binding": "RECOVERY", "bucket_name": "scry-recovery" }],
  "vars": {
    "MEMORY_ENGINE_ENVIRONMENT": "production",
    "MEMORY_ENGINE_MAIL_MODE": "resend",
    "MEMORY_ENGINE_PUBLIC_BASE_URL": "https://scry.misty-step.workers.dev"
  },
  "env": {
    "staging": {
      "name": "scry-staging",
      "durable_objects": { "bindings": [{ "name": "SCRY", "class_name": "Scry" }] },
      "r2_buckets": [{ "binding": "RECOVERY", "bucket_name": "scry-staging-recovery" }],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "MEMORY_ENGINE_ENVIRONMENT": "staging",
        "MEMORY_ENGINE_MAIL_MODE": "resend",
        "MEMORY_ENGINE_PUBLIC_BASE_URL": "https://scry-staging.misty-step.workers.dev"
      }
    },
    "production": {
      "name": "scry",
      "durable_objects": { "bindings": [{ "name": "SCRY", "class_name": "Scry" }] },
      "r2_buckets": [{ "binding": "RECOVERY", "bucket_name": "scry-recovery" }],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "MEMORY_ENGINE_ENVIRONMENT": "production",
        "MEMORY_ENGINE_MAIL_MODE": "resend",
        "MEMORY_ENGINE_PUBLIC_BASE_URL": "https://scry.misty-step.workers.dev"
      }
    }
  }
}
