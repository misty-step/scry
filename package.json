{
  "name": "scry",
  "version": "0.9.7",
  "description": "Private memorization with agent-authored content and native grading.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "fflate": "0.8.3",
    "wrangler": "4.129.0",
    "miniflare": "5.20260903.0-alpha",
    "playwright": "1.63.0",
    "jose": "6.2.12"
  },
  "scripts": {
    "test": "cargo test --locked --all-targets",
    "dev": "bash scripts/rust-dev",
    "ci:local": "python3 scripts/scry-ci local",
    "ci:full": "python3 scripts/scry-ci full",
    "ci": "python3 scripts/scry-ci local",
    "build": "worker-build --release --locked",
    "check": "cargo fmt --all -- --check && cargo clippy --locked --all-targets -- -D warnings && cargo clippy --locked --target wasm32-unknown-unknown -- -D warnings",
    "test:runtime": "node --test qa/runtime.test.mjs",
    "walk": "qa/walk --all",
    "rust-dev": "bash scripts/rust-dev"
  }
}
