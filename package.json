{
  "name": "scry",
  "version": "0.0.0",
  "description": "Scry's private Go, SQLite and HTMX learning application.",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22" },
  "devDependencies": {
    "wrangler": "4.129.0"
  },
  "scripts": {
    "test": "go test -count=1 -mod=readonly ./...",
    "test:recovery": "python3 scripts/scry-ci recovery",
    "dev": "go run -mod=readonly ./cmd/scry serve --dev",
    "ops:legacy-data": "python3 scripts/scry-cloudflare-data",
    "ops:legacy-restore": "python3 bin/scry-restore",
    "ops:legacy-backup-freshness": "python3 bin/scry-backup-freshness",
    "ci:local": "python3 scripts/scry-ci local",
    "ci:full": "python3 scripts/scry-ci full",
    "ci": "python3 scripts/scry-ci local"
  }
}
