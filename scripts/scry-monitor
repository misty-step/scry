#!/usr/bin/env python3
"""Read-only public status or stateful operator mail; Python standard library only."""
import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import http.client
import ipaddress
import json
import math
import os
from pathlib import Path
import re
import signal
import tempfile
from urllib.parse import urlsplit
import uuid


ORIGINS = {
    "production": "https://scry.misty-step.workers.dev",
    "staging": "https://scry-staging.misty-step.workers.dev",
}
RESEND_URL = "https://api.resend.com/emails"
HEALTH_SCHEMA = "memory_engine.runtime_health.v1"
STATE_SCHEMA = "scry.monitor.state.v1"
RECEIPT_SCHEMA = "scry.monitor.receipt.v1"
MAX_BACKUP_AGE_MS = 90_000_000
MAX_BODY_BYTES = 16_384
REQUEST_TIMEOUT_SECONDS = 10
LABEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,47}\Z")
LIMITATIONS = [
    "External observations and GitHub five-minute scheduling are best effort, not an SLA.",
    "Notification state/cache can expire or be lost; it is not durable alert history.",
    "Provider acceptance is not inbox delivery; Resend idempotency expires after 24 hours.",
    "Pending mail keeps its original observation; current health is reconciled after acceptance.",
]


class MonitorError(Exception):
    def __init__(self, code, http_status=None):
        super().__init__(code)
        self.code = code
        self.http_status = http_status


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def valid_time(value):
    if not isinstance(value, str) or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", value):
        return False
    try:
        datetime.fromisoformat(value.replace("Z", "+00:00"))
        return True
    except ValueError:
        return False


def strict_json(raw):
    def object_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate_key")
            result[key] = value
        return result

    def invalid_constant(_):
        raise ValueError("nonfinite_number")

    def finite_float(value):
        number = float(value)
        if not math.isfinite(number):
            raise ValueError("nonfinite_number")
        return number

    return json.loads(raw.decode("utf-8"), object_pairs_hook=object_pairs,
                      parse_constant=invalid_constant, parse_float=finite_float)


def save_json(path, value, mode):
    """Persist before a mail side effect, using the scripts' fsync/replace pattern."""
    temporary = None
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            os.fchmod(stream.fileno(), mode)
            json.dump(value, stream, sort_keys=True, separators=(",", ":"), allow_nan=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def local_origin(value):
    try:
        parsed = urlsplit(value)
        address = ipaddress.ip_address(parsed.hostname or "")
        if (parsed.scheme != "http" or not address.is_loopback or parsed.port is None
                or not 1 <= parsed.port <= 65535 or parsed.username is not None
                or parsed.password is not None or parsed.path not in ("", "/")
                or parsed.query or parsed.fragment or "%" in value
                or any(character.isspace() or ord(character) < 32 for character in value)):
            raise ValueError
        host = f"[{address}]" if address.version == 6 else str(address)
        canonical = f"http://{host}:{parsed.port}"
        if value.rstrip("/") != canonical:
            raise ValueError
        return canonical
    except ValueError:
        raise argparse.ArgumentTypeError(
            "local probe override requires a numeric HTTP loopback origin with an explicit port"
        ) from None


def drill_label(value):
    if not LABEL.fullmatch(value):
        raise argparse.ArgumentTypeError("drill label must be 1-48 ASCII letters, digits, '_' or '-'")
    return value


def request_json(url, method="GET", payload=None, headers=None):
    """No redirects, proxy environment, cookies, or ambient authentication.

    The wall-clock alarm also bounds DNS and a peer that trickles response bytes;
    socket timeouts alone would only bound each individual read. This CLI is POSIX.
    """
    def timed_out(_signal, _frame):
        raise TimeoutError

    parsed = urlsplit(url)
    connection_type = http.client.HTTPSConnection if parsed.scheme == "https" else http.client.HTTPConnection
    connection = connection_type(parsed.hostname, parsed.port, timeout=REQUEST_TIMEOUT_SECONDS)
    request_headers = {"Accept": "application/json", "User-Agent": "scry-monitor", "Cache-Control": "no-cache"}
    if headers:
        request_headers.update(headers)
    status = None
    previous_handler = signal.signal(signal.SIGALRM, timed_out)
    signal.setitimer(signal.ITIMER_REAL, REQUEST_TIMEOUT_SECONDS)
    try:
        connection.request(method, parsed.path or "/", body=payload, headers=request_headers)
        response = connection.getresponse()
        status = response.status
        # http.client never follows Location, including on the credential-bearing POST.
        if 300 <= status < 400:
            raise MonitorError("response_redirect", status)
        if not 200 <= status < 300:
            raise MonitorError("response_non_2xx", status)
        if response.getheader("Content-Type", "").split(";", 1)[0].strip().lower() != "application/json":
            raise MonitorError("response_not_json", status)
        raw = response.read(MAX_BODY_BYTES + 1)
        if len(raw) > MAX_BODY_BYTES:
            raise MonitorError("response_too_large", status)
        try:
            return status, strict_json(raw)
        except (ValueError, UnicodeError, RecursionError):
            raise MonitorError("response_invalid_json", status) from None
    except TimeoutError:
        raise MonitorError("request_timeout", status) from None
    except (OSError, http.client.HTTPException):
        raise MonitorError("network_error", status) from None
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        connection.close()


def probe(origin, path):
    result = {"path": path, "startedAt": now(), "httpStatus": None,
              "status": "unhealthy", "errorCode": None}
    try:
        status, data = request_json(origin + path)
        result["httpStatus"] = status
        if not isinstance(data, dict):
            raise MonitorError("health_invalid_shape", status)
        if path == "/statusz":
            if data.get("schema") != HEALTH_SCHEMA:
                raise MonitorError("health_schema_mismatch", status)
            if data.get("status") != "healthy" or data.get("maintenance") is not False:
                raise MonitorError("health_not_active", status)
            age = data.get("backupAgeMs")
            # bool is an int subclass; JSON floats, null and booleans must all fail.
            if type(age) is not int or not 0 <= age <= MAX_BACKUP_AGE_MS:
                raise MonitorError("health_backup_invalid_or_stale", status)
        elif data.get("status") != ("ok" if path == "/healthz" else "ready"):
            raise MonitorError("health_status_mismatch", status)
        result["status"] = "healthy"
    except MonitorError as error:
        result["errorCode"] = error.code
        result["httpStatus"] = error.http_status
    result["finishedAt"] = now()
    return result


def receipt_id(value):
    if not isinstance(value, str) or not re.fullmatch(
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value):
        return False
    return uuid.UUID(value).int != 0


def valid_pending(value, environment, kinds):
    if not isinstance(value, dict) or set(value) != {
            "kind", "observedAt", "idempotencyKey", "subject", "text", "label",
            "payloadSha256", "firstAttemptAt"}:
        return False
    if (value["kind"] not in kinds or not valid_time(value["observedAt"])
            or not isinstance(value["idempotencyKey"], str)
            or not value["idempotencyKey"].startswith(f"scry-monitor/{environment}/")
            or len(value["idempotencyKey"]) != len(f"scry-monitor/{environment}/") + 36
            or not receipt_id(value["idempotencyKey"].rsplit("/", 1)[-1])):
        return False
    for field, limit in (("subject", 180), ("text", 3072)):
        text = value[field]
        if (not isinstance(text, str) or not 1 <= len(text) <= limit
                or not all(" " <= character <= "~" or (field == "text" and character == "\n")
                           for character in text)):
            return False
    label = value["label"]
    if value["kind"] == "delivery_drill":
        if not isinstance(label, str) or not LABEL.fullmatch(label):
            return False
    elif label is not None:
        return False
    digest = value["payloadSha256"]
    if digest is None:
        return value["firstAttemptAt"] is None
    return (isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest) is not None
            and valid_time(value["firstAttemptAt"]))


def fresh_state(environment, origin):
    return {"schema": STATE_SCHEMA, "environment": environment, "origin": origin,
            "notifiedStatus": None, "observation": None, "pending": None,
            "drill": None, "lastDrill": None}


def load_state(path, environment, origin):
    try:
        with path.open("rb") as stream:
            raw = stream.read(MAX_BODY_BYTES + 1)
    except FileNotFoundError:
        return fresh_state(environment, origin), "initialized"
    except OSError:
        raise MonitorError("state_unreadable") from None
    try:
        state = strict_json(raw)
        if (len(raw) > MAX_BODY_BYTES or not isinstance(state, dict)
                or set(state) != set(fresh_state(environment, origin))
                or state["schema"] != STATE_SCHEMA or state["environment"] != environment
                or state["origin"] != origin or state["notifiedStatus"] not in (None, "healthy", "unhealthy")):
            raise ValueError
        observation = state["observation"]
        if observation is not None and (
                not isinstance(observation, dict) or set(observation) != {"status", "at"}
                or observation["status"] not in ("healthy", "unhealthy")
                or not valid_time(observation["at"])):
            raise ValueError
        for field, kinds in (("pending", ("unhealthy", "recovery")), ("drill", ("delivery_drill",))):
            if state[field] is not None and not valid_pending(state[field], environment, kinds):
                raise ValueError
        if state["pending"] is not None:
            if ((state["pending"]["kind"] == "recovery") != (state["notifiedStatus"] == "unhealthy")):
                raise ValueError
        drill = state["lastDrill"]
        if drill is not None and (
                not isinstance(drill, dict) or set(drill) != {"label", "acceptedAt", "receiptId"}
                or not isinstance(drill["label"], str) or not LABEL.fullmatch(drill["label"])
                or not valid_time(drill["acceptedAt"]) or not receipt_id(drill["receiptId"])):
            raise ValueError
        return state, "restored"
    except (ValueError, UnicodeError, RecursionError):
        raise MonitorError("state_invalid") from None


def pending_notification(kind, receipt, label=None):
    environment = receipt["environment"]
    scope = f"LOCAL PROBE {environment.upper()}" if receipt["localProbe"] else environment.upper()
    title = {"unhealthy": "UNHEALTHY", "recovery": "RECOVERY", "delivery_drill": "DELIVERY DRILL"}[kind]
    subject = f"[Scry][{scope}] {title}" + (f" [{label}]" if label else "")
    lines = [subject, f"Origin: {receipt['origin']}", f"Observed at: {receipt['observedAt']}"]
    if kind == "delivery_drill":
        lines.append("Explicit operator delivery drill. This message does not assert a production incident.")
    else:
        lines.append(f"Observed service status: {receipt['status']}")
        lines.extend(f"{check['path']}: {check['errorCode'] or 'healthy'}" for check in receipt["checks"])
    lines.extend(["", "This is an observation snapshot; delayed retries can describe an earlier state.",
                  "Provider acceptance is not inbox delivery. Scheduling and notification state are best effort."])
    return {"kind": kind, "observedAt": receipt["observedAt"],
            "idempotencyKey": f"scry-monitor/{environment}/{uuid.uuid4()}", "subject": subject,
            "text": "\n".join(lines), "label": label, "payloadSha256": None, "firstAttemptAt": None}


def mail_configuration():
    key = os.environ.get("RESEND_API_KEY", "")
    sender = os.environ.get("MEMORY_ENGINE_MAIL_FROM", "").strip()
    recipient = os.environ.get("MEMORY_ENGINE_ALERT_TO", "").strip()
    if (not 1 <= len(key) <= 512 or not all("!" <= character <= "~" for character in key)
            or not 1 <= len(sender) <= 512 or any(ord(character) < 32 or ord(character) == 127 for character in sender)):
        raise MonitorError("notification_configuration_invalid")
    sender_address = sender
    if "<" in sender:
        match = re.fullmatch(r"([^<>]+) <([^<>]+)>", sender)
        if match is None:
            raise MonitorError("notification_configuration_invalid")
        sender_address = match[2]
    for address in (sender_address, recipient):
        if (not 3 <= len(address) <= 320 or address.count("@") != 1
                or not re.fullmatch(r"[^\s<>;,\"@]+@[^\s<>;,\"@]+\.[^\s<>;,\"@]+", address)
                or any(ord(character) < 33 or ord(character) == 127 for character in address)):
            raise MonitorError("notification_configuration_invalid")
    return key, sender, recipient


def deliver(state, field, state_path, receipt):
    pending = state[field]
    event = {"kind": pending["kind"], "label": pending["label"],
             "observedAt": pending["observedAt"], "idempotencyKey": pending["idempotencyKey"],
             "delivery": "not_attempted", "attemptedAt": None, "httpStatus": None,
             "receiptId": None, "errorCode": None}
    receipt["notifications"].append(event)
    try:
        key, sender, recipient = mail_configuration()
        payload = json.dumps({"from": sender, "to": [recipient], "subject": pending["subject"],
                              "text": pending["text"]}, sort_keys=True, separators=(",", ":")).encode()
        digest = hashlib.sha256(payload).hexdigest()
        # Cache no sender/recipient or key. Bind the exact envelope on first attempt;
        # changed environment configuration must never send changed content under this key.
        if pending["payloadSha256"] not in (None, digest):
            raise MonitorError("notification_envelope_changed")
        pending["payloadSha256"] = digest
        pending["firstAttemptAt"] = pending["firstAttemptAt"] or now()
        save_json(state_path, state, 0o600)
        event["attemptedAt"] = now()
        status, data = request_json(RESEND_URL, "POST", payload, {
            "Authorization": f"Bearer {key}", "Content-Type": "application/json",
            "Idempotency-Key": pending["idempotencyKey"],
        })
        event["httpStatus"] = status
        if not isinstance(data, dict) or not receipt_id(data.get("id")):
            raise MonitorError("notification_receipt_invalid", status)
        event["delivery"] = "provider_accepted"
        event["receiptId"] = data["id"]
        event["acceptedAt"] = now()
        if field == "pending":
            state["notifiedStatus"] = "unhealthy" if pending["kind"] == "unhealthy" else "healthy"
        else:
            state["lastDrill"] = {"label": pending["label"], "acceptedAt": event["acceptedAt"],
                                  "receiptId": event["receiptId"]}
        state[field] = None
        save_json(state_path, state, 0o600)
        return True
    except MonitorError as error:
        event["delivery"] = "acceptance_unconfirmed" if event["attemptedAt"] else "not_attempted"
        event["httpStatus"] = error.http_status
        event["errorCode"] = error.code
        return False


def observe_and_notify(args, receipt):
    try:
        state, receipt["state"] = load_state(args.state_file, args.environment, receipt["origin"])
    except MonitorError as error:
        # A malformed/foreign cache must not suppress an incident. A reset is visible
        # and fails this run; cache loss can produce duplicate alerts, not durable history.
        receipt["errors"].append(error.code)
        receipt["state"] = "reset"
        state = fresh_state(args.environment, receipt["origin"])
    state["observation"] = {"status": receipt["status"], "at": receipt["observedAt"]}
    save_json(args.state_file, state, 0o600)
    health_pending_ok = state["pending"] is None or deliver(state, "pending", args.state_file, receipt)
    if health_pending_ok:
        if state["notifiedStatus"] is None and receipt["status"] == "healthy":
            state["notifiedStatus"] = "healthy"  # First healthy observation initializes quietly.
            save_json(args.state_file, state, 0o600)
        elif state["notifiedStatus"] != receipt["status"]:
            kind = "unhealthy" if receipt["status"] == "unhealthy" else "recovery"
            state["pending"] = pending_notification(kind, receipt)
            save_json(args.state_file, state, 0o600)
            deliver(state, "pending", args.state_file, receipt)
    if args.delivery_drill:
        if state["drill"] is not None and state["drill"]["label"] != args.delivery_drill:
            receipt["errors"].append("notification_drill_pending")
        elif state["drill"] is None:
            if state["lastDrill"] is not None and state["lastDrill"]["label"] == args.delivery_drill:
                receipt["notifications"].append({"kind": "delivery_drill", "label": args.delivery_drill,
                    "delivery": "already_provider_accepted", "receiptId": state["lastDrill"]["receiptId"],
                    "acceptedAt": state["lastDrill"]["acceptedAt"], "errorCode": None})
            else:
                state["drill"] = pending_notification("delivery_drill", receipt, args.delivery_drill)
                save_json(args.state_file, state, 0o600)
    if state["drill"] is not None:
        deliver(state, "drill", args.state_file, receipt)
    receipt["pending"] = {"health": state["pending"] is not None, "drill": state["drill"] is not None}


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Notifications use only RESEND_API_KEY, MEMORY_ENGINE_MAIL_FROM and MEMORY_ENGINE_ALERT_TO. "
        "No learner/admin credentials or mail endpoint overrides are used. "
        "Scheduling/cache are best effort; provider acceptance is not inbox delivery. "
        "POSIX only; serialize invocations sharing a state file."
    ))
    parser.add_argument("--environment", choices=tuple(ORIGINS), required=True)
    parser.add_argument("--status", action="store_true",
                        help="read-only public probes; no credentials, notification state, locks, or mail")
    parser.add_argument("--state-file", type=Path, help="private notification state; forbidden with --status")
    parser.add_argument("--receipt-file", type=Path, help="sanitized JSON receipt; optional with --status")
    parser.add_argument("--delivery-drill", type=drill_label, metavar="LABEL",
                        help="send an explicitly labeled drill; repeating the latest accepted label is quiet")
    parser.add_argument("--local-probe-origin", type=local_origin, metavar="ORIGIN",
                        help="isolated numeric HTTP loopback only; does not change the fixed Resend endpoint")
    args = parser.parse_args()
    if args.status:
        if args.state_file is not None or args.delivery_drill is not None:
            parser.error("--status cannot use notification state or request a delivery drill")
    else:
        if args.state_file is None or args.receipt_file is None:
            parser.error("notification runs require --state-file and --receipt-file")
        if args.state_file.resolve() == args.receipt_file.resolve():
            parser.error("state and receipt paths must differ")
    receipt = {"schema": RECEIPT_SCHEMA, "environment": args.environment,
               "origin": args.local_probe_origin or ORIGINS[args.environment],
               "localProbe": args.local_probe_origin is not None, "startedAt": now(),
               "mode": "status" if args.status else "notify",
               "checks": [], "notifications": [], "errors": [],
               "state": "not_used" if args.status else "not_loaded", "pending": None,
               "limitations": [
                   "Point-in-time health is not product acceptance, restore proof, or deployment authorization."
               ] if args.status else LIMITATIONS}
    for path in ("/healthz", "/readyz", "/statusz"):
        receipt["checks"].append(probe(receipt["origin"], path))
    receipt["observedAt"] = now()
    receipt["status"] = "healthy" if all(check["status"] == "healthy" for check in receipt["checks"]) else "unhealthy"
    if not args.status:
        try:
            mail_configuration()
        except MonitorError as error:
            receipt["errors"].append(error.code)
        try:
            args.state_file.parent.mkdir(parents=True, exist_ok=True)
            # GitHub serializes per environment; this protects direct local invocations too.
            with args.state_file.with_name(args.state_file.name + ".lock").open("a") as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise MonitorError("state_locked") from None
                observe_and_notify(args, receipt)
        except MonitorError as error:
            receipt["errors"].append(error.code)
        except OSError:
            receipt["errors"].append("state_write_failed")
    receipt["finishedAt"] = now()
    failed = (receipt["status"] != "healthy" or bool(receipt["errors"])
              or any(event["errorCode"] for event in receipt["notifications"]))
    receipt["result"] = "failed" if failed else "ok"
    if args.receipt_file is not None:
        try:
            save_json(args.receipt_file, receipt, 0o644)
        except OSError:
            receipt["errors"].append("receipt_write_failed")
            receipt["result"] = "failed"
            failed = True
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":"), allow_nan=False))
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
