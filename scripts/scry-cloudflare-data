#!/usr/bin/env python3
"""Private, bounded PostgreSQL export and Cloudflare recovery operations.

PostgreSQL is read only: this command never loads PostgresStudyStore or applies
migrations. An operator must stop old writers separately before primary import.
No credential may be provided in command-line arguments or printed in receipts.
"""
import argparse
import ctypes
import ctypes.util
import hashlib
import inspect
import json
import os
