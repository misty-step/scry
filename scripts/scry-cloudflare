#!/usr/bin/env python3
"""Build, exercise, and explicitly promote immutable Scry Worker bundles."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import html
import http.cookiejar
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
from threading import Thread
import tomllib
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from scry_ops import OperationError, private_env  # noqa: E402

REPO = Path(__file__).resolve().parent.parent
TOOLS = REPO / "target/cloudflare-tools"
RUST = "1.94.0"
WORKER = "0.8.5"
BINDGEN = "0.2.125"
WRANGLER = "4.129.0"
ESBUILD = "0.28.1"
ACCOUNT = "b069014f6a46558ea9146fb6c4ff8f6c"
REPOSITORY = "misty-step/scry"
CRATE = "crates/memory-engine-cloudflare"
SCHEMA = "scry.worker-bundle.v1"
RECEIPT = "scry.worker-operation.v1"
PROOF = "scry.workerd-proof.v1"
IGNORED = {".git", "node_modules", "target", "dist", ".tmp", ".wrangler", "__pycache__"}


def require(condition, message):
    if not condition:
        raise OperationError(message)


def run(argv, *, cwd=REPO, env=None, check=True):
    result = subprocess.run([str(arg) for arg in argv], cwd=cwd, env=env,
                            capture_output=True, text=True)
    if check and result.returncode:
        # Keep diagnostic output private instead of leaking provider bindings to CI.
        with tempfile.NamedTemporaryFile(prefix="scry-command-", suffix=".log", delete=False) as log:
            os.fchmod(log.fileno(), 0o600)
            log.write((result.stdout + "\n" + result.stderr).encode())
        raise OperationError(f"{Path(argv[0]).name} failed (exit {result.returncode}); private log: {log.name}")
    return result


def sha(data):
    return hashlib.sha256(data).hexdigest()


def digest(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def encoded(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def load(path):
    return json.loads(Path(path).read_text())


def save(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        os.fchmod(stream.fileno(), 0o600)
        stream.write(encoded(value))
        stream.flush()
        os.fsync(stream.fileno())


def safe_path(name):
    path = PurePosixPath(name)
    require(not path.is_absolute() and ".." not in path.parts and str(path) == name,
            "unsafe source or artifact path")
    return path


def source_files(root):
    if (root / ".git").exists():
        paths = run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=root).stdout.split("\0")
        return sorted({name for name in paths if name and ((root / name).exists() or (root / name).is_symlink())})
    # Dagger supplies an already gitignore-filtered source Directory, without .git.
    paths = []
    for directory, children, files in os.walk(root, followlinks=False):
        children[:] = sorted(name for name in children if name not in IGNORED)
        for name in files + [name for name in children if (Path(directory) / name).is_symlink()]:
            path = Path(directory) / name
            paths.append(path.relative_to(root).as_posix())
    return sorted(paths)


def snapshot_source(destination, revision=None):
    if (REPO / ".git").exists():
        actual = run(["git", "rev-parse", "HEAD"]).stdout.strip()
        require(revision is None or revision == actual, "--revision does not match HEAD")
        revision = actual
    require(revision and re.fullmatch(r"[0-9a-f]{40}", revision), "a full source revision is required outside a Git checkout")
    inventory = {}
    for name in source_files(REPO):
        safe_path(name)
        source, target = REPO / name, destination / name
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            require(not name.startswith(("crates/", ".cargo/")), "build inputs must not escape through symlinks")
            link = os.readlink(source)
            target.symlink_to(link)
            inventory[name] = {"sha256": sha(os.fsencode(link)), "mode": "120000"}
        else:
            require(source.is_file(), "unsupported source entry")
            # Hash exactly the bytes copied to the isolated build, not a later read.
            data = source.read_bytes()
            mode = "100755" if source.stat().st_mode & stat.S_IXUSR else "100644"
            target.write_bytes(data)
            target.chmod(0o755 if mode == "100755" else 0o644)
            inventory[name] = {"sha256": sha(data), "mode": mode}
    return revision, inventory


def clean_environment(local=False):
    allowed = ("PATH", "HOME", "USER", "TMPDIR", "SSL_CERT_FILE", "SSL_CERT_DIR",
               "CARGO_HOME", "RUSTUP_HOME", "CARGO_BUILD_JOBS")
    result = {key: os.environ[key] for key in allowed if key in os.environ}
    result.update({"CI": "true", "WRANGLER_SEND_METRICS": "false", "TZ": "UTC",
                   "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV": "false",
                   "WRANGLER_LOG_SANITIZE": "true"})
    if not local:
        for key in ("CLOUDFLARE_API_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"):
            if key in os.environ:
                result[key] = os.environ[key]
        result["CLOUDFLARE_ACCOUNT_ID"] = ACCOUNT
    return result


def wrangler_path():
    package = REPO / "node_modules/wrangler/package.json"
    require(package.is_file() and load(package)["version"] == WRANGLER,
            "run bun run worker:tools to install the pinned Wrangler")
    return REPO / "node_modules/wrangler/bin/wrangler.js"


def wrangler(argv, config, *, environment=None, local=False, output=None, check=True):
    args = ["node", wrangler_path(), *argv, "--config", config]
    if environment:
        args += ["--env", environment]
    env = clean_environment(local)
    if output:
        env["WRANGLER_OUTPUT_FILE_PATH"] = str(output)
    return run(args, cwd=Path(config).parent, env=env, check=check)


def install_tools():
    run(["npm", "ci", "--no-audit", "--no-fund"], env=clean_environment(local=True))
    run(["rustup", "target", "add", "--toolchain", RUST, "wasm32-unknown-unknown"], env=clean_environment(local=True))
    for package, version in (("worker-build", WORKER), ("wasm-bindgen-cli", BINDGEN)):
        run(["cargo", f"+{RUST}", "install", "--locked", "--version", f"={version}",
             "--root", TOOLS, package], env=clean_environment(local=True))
    print(f"toolchain installed: Rust {RUST}, worker-build {WORKER}, wasm-bindgen {BINDGEN}, Wrangler {WRANGLER}")


def check_tools():
    paths = {"worker-build": TOOLS / "bin/worker-build", "wasm-bindgen": TOOLS / "bin/wasm-bindgen",
             "esbuild": REPO / "node_modules/.bin/esbuild"}
    expected = {"worker-build": WORKER, "wasm-bindgen": f"wasm-bindgen {BINDGEN}", "esbuild": ESBUILD}
    hashes = {}
    for name, path in paths.items():
        require(path.is_file(), "run bun run worker:tools before building")
        require(run([path, "--version"], env=clean_environment(local=True)).stdout.strip() == expected[name], f"unpinned {name}")
        hashes[name] = digest(path)
    rustc = run(["rustc", f"+{RUST}", "--version"], env=clean_environment(local=True)).stdout.strip()
    require(rustc.startswith(f"rustc {RUST} "), "unexpected Rust compiler")
    wrangler_path()
    return paths, {"rustc": rustc, "worker": WORKER, "worker_build": WORKER,
                   "wasm_bindgen": BINDGEN, "wrangler": WRANGLER, "esbuild": ESBUILD,
                   "wasm_opt": "130", "binaries_sha256": hashes}


def build_bundle(out, revision=None):
    out = Path(out).resolve()
    require(not out.exists(), "artifact output already exists; immutable bundles are never overwritten")
    paths, tools = check_tools()
    with tempfile.TemporaryDirectory(prefix="scry-worker-source-") as temporary:
        source = Path(temporary) / "source"
        source.mkdir()
        revision, inventory = snapshot_source(source, revision)
        lock = tomllib.loads((source / "Cargo.lock").read_text())
        for name, version in (("worker", WORKER), ("wasm-bindgen", BINDGEN)):
            require({entry["version"] for entry in lock["package"] if entry["name"] == name} == {version},
                    f"Cargo.lock must pin {name} exactly to {version}")
        source_hash = sha(encoded(inventory))
        env = clean_environment(local=True)
        env.update({"RUSTUP_TOOLCHAIN": RUST, "SOURCE_DATE_EPOCH": "0",
                    "CARGO_TARGET_DIR": str(REPO / "target/cloudflare-cargo"),
                    "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS":
                        f'--cfg getrandom_backend="wasm_js" --remap-path-prefix={source}=/scry',
                    "WASM_BINDGEN_BIN": str(paths["wasm-bindgen"]),
                    "ESBUILD_BIN": str(paths["esbuild"])})
        run([paths["worker-build"], source / CRATE, "--release", "--out-dir", "build",
             "--locked", "--no-default-features"], cwd=source, env=env)
        stage = Path(temporary) / "bundle"
        (stage / "worker").mkdir(parents=True)
        for name in ("index.js", "index_bg.wasm"):
            shutil.copyfile(source / CRATE / "build" / name, stage / "worker" / name)
        require((stage / "worker/index_bg.wasm").read_bytes()[:8] == b"\0asm\x01\0\0\0", "invalid compiled Wasm module")
        config = json.loads((source / "wrangler.jsonc").read_text())
        require(config["account_id"] == ACCOUNT, "unexpected Cloudflare account")
        require(not config.get("routes") and not config.get("route"), "custom domains require a separately reviewed DNS cutover")
        config.pop("$schema", None)
        config["main"] = "worker/index.js"
        config["base_dir"] = "worker"
        require(config.get("no_bundle") is True and "build" not in config, "deployment must not rebuild artifact bytes")
        for target in [config, *config["env"].values()]:
            require(not target.get("routes") and not target.get("route"), "custom routes are not yet authorized")
            target["vars"].update({"SCRY_REVISION": revision, "SCRY_SOURCE_SHA256": source_hash})
        save(stage / "wrangler.json", config)
        save(stage / "source.json", inventory)
        migrations = []
        for path in sorted((source / CRATE / "migrations").glob("[0-9][0-9][0-9]-*.sql")):
            migrations.append({"version": int(path.name[:3]), "name": path.name, "sha256": digest(path)})
        require([item["version"] for item in migrations] == list(range(1, len(migrations) + 1)) and migrations,
                "SQLite migration ledger is missing or noncontiguous")
        files = {path.relative_to(stage).as_posix(): digest(path)
                 for path in sorted(stage.rglob("*")) if path.is_file()}
        manifest = {"schema": SCHEMA, "revision": revision, "source_sha256": source_hash,
                    "target": "wasm32-unknown-unknown", "tools": tools,
                    "cargo_flags": ["--release", "--locked", "--no-default-features"],
                    "wasm_cfg": 'getrandom_backend="wasm_js"',
                    "schema_ledger": migrations, "schema_sha256": sha(encoded(migrations)),
                    "files": files}
        save(stage / "manifest.json", manifest)
        # The actual deploy packager must accept these bytes without compilation.
        wrangler(["deploy", "--dry-run", "--no-bundle", "--outdir", str(Path(temporary) / "dry-run")],
                 stage / "wrangler.json", environment="staging", local=True)
        verify_bundle(stage)
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(stage, out)
    print(f"artifact={out} revision={revision} source_sha256={source_hash} bundle_sha256={digest(out / 'manifest.json')}")
    return out


def verify_bundle(artifact):
    artifact = Path(artifact).resolve()
    require(not artifact.is_symlink(), "artifact must be a real directory")
    manifest = load(artifact / "manifest.json")
    require(manifest.get("schema") == SCHEMA, "unknown artifact schema")
    require(manifest.get("target") == "wasm32-unknown-unknown", "not a Worker artifact")
    require(manifest["tools"]["worker_build"] == WORKER and manifest["tools"]["wrangler"] == WRANGLER
            and manifest["tools"]["wasm_bindgen"] == BINDGEN, "artifact toolchain mismatch")
    expected = set(manifest["files"]) | {"manifest.json"}
    actual = set()
    for path in artifact.rglob("*"):
        require(not path.is_symlink(), "artifact must not contain symlinks")
        if path.is_file():
            actual.add(path.relative_to(artifact).as_posix())
    require(actual == expected, "artifact contains missing or unmanifested files")
    for name, expected_hash in manifest["files"].items():
        safe_path(name)
        require(digest(artifact / name) == expected_hash, f"artifact checksum mismatch: {name}")
    require(manifest["source_sha256"] == sha(encoded(load(artifact / "source.json"))), "source manifest checksum mismatch")
    require(manifest["schema_sha256"] == sha(encoded(manifest["schema_ledger"])), "schema ledger checksum mismatch")
    config = load(artifact / "wrangler.json")
    require(config.get("account_id") == ACCOUNT and config.get("no_bundle") is True
            and config.get("main") == "worker/index.js" and config.get("base_dir") == "worker"
            and "build" not in config, "artifact is not configured for exact-byte Worker deployment")
    require(config.get("migrations") == [{"tag": "v1", "new_sqlite_classes": ["Scry"]}],
            "Durable Object class lifecycle changed; ordinary release/rollback cannot apply it")
    require(set(config["env"]) == {"staging", "production"}, "unexpected environment set")
    for environment, expected_name, bucket in (("staging", "scry-staging", "scry-staging-recovery"),
                                               ("production", "scry", "scry-recovery")):
        target = config["env"][environment]
        require(target.get("name") == expected_name
                and target.get("durable_objects") == {"bindings": [{"name": "SCRY", "class_name": "Scry"}]}
                and target.get("r2_buckets") == [{"binding": "RECOVERY", "bucket_name": bucket}],
                "artifact environment bindings do not match the reviewed isolated resources")
        require(target["vars"].get("MEMORY_ENGINE_MAIL_MODE") == "resend",
                "deployed mail must use the reviewed Resend transport")
        require(not target.get("route") and not target.get("routes")
                and not config.get("route") and not config.get("routes"),
                "custom-domain routing requires a separate reviewed DNS cutover")
    return manifest


def free_port():
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise OperationError("Worker HTTP redirects are forbidden; credentials stay on the selected origin")


def request(base, route, *, method="GET", body=None, token=None, admin=None, expected=(200,)):
    headers = {"accept": "application/json", "user-agent": "scry-cloudflare"}
    if token:
        headers["authorization"] = f"Bearer {token}"
    if admin:
        headers["x-admin-token"] = admin
    data = None
    if body is not None:
        data = encoded(body)
        headers["content-type"] = "application/json"
    req = urllib.request.Request(base + route, data=data, headers=headers, method=method)
    try:
        response = urllib.request.build_opener(NoRedirect()).open(req, timeout=20)
    except urllib.error.HTTPError as error:
        response = error
    with response:
        require(response.status in expected, f"HTTP {response.status}, expected {expected}, at {route.split('?')[0]}")
        content = response.read(8 * 1024 * 1024 + 1)
        require(len(content) <= 8 * 1024 * 1024, "HTTP response exceeded safety bound")
        return json.loads(content) if content and "application/json" in response.headers.get("content-type", "") else content


class LocalWorker:
    """Only the spawned process group and an explicit private persistence directory."""
    def __init__(self, artifact, state, port=0, email="dev@example.test", additional_emails=(), provider_env=None):
        provider = private_env(provider_env) if provider_env else {}
        if provider_env:
            require(set(provider) <= {"OPENROUTER_API_KEY", "MEMORY_ENGINE_GENERATION_MODEL"},
                    "provider env may contain only OPENROUTER_API_KEY and MEMORY_ENGINE_GENERATION_MODEL")
            require(provider.get("OPENROUTER_API_KEY") and provider.get("MEMORY_ENGINE_GENERATION_MODEL"),
                    "provider env requires an explicit API key and model")
        self.artifact = Path(artifact).resolve()
        self.manifest = verify_bundle(self.artifact)
        self.state = Path(state).resolve()
        self.state.mkdir(parents=True, exist_ok=False, mode=0o700)
        copied = self.state / "bundle"
        shutil.copytree(self.artifact, copied)
        self.artifact = copied
        verify_bundle(self.artifact)
        self.port = port or free_port()
        self.base = f"http://127.0.0.1:{self.port}"
        self.admin = secrets.token_hex(32)
        self.email = email
        self.activated = False
        self.process = None
        self.log = None
        config = load(self.artifact / "wrangler.json")
        config.pop("env")
        config.pop("account_id")
        config["name"] = f"scry-local-{secrets.token_hex(6)}"
        config["main"] = str(self.artifact / "worker/index.js")
        config["base_dir"] = str(self.artifact / "worker")
        config["vars"].update({"MEMORY_ENGINE_ENVIRONMENT": "development",
                              "MEMORY_ENGINE_MAIL_MODE": "local-outbox",
                              "MEMORY_ENGINE_AUTH_EXPOSE_DEBUG_LINKS": "true",
                              "MEMORY_ENGINE_AUTH_ALLOWED_EMAILS": ",".join((email, *additional_emails)),
                              "MEMORY_ENGINE_ADMIN_TOKEN": self.admin,
                              "MEMORY_ENGINE_RETURN_UNSUBSCRIBE_SECRET": secrets.token_hex(32),
                              "MEMORY_ENGINE_MAIL_FROM": "scry@example.test",
                              "MEMORY_ENGINE_PUBLIC_BASE_URL": self.base})
        config["vars"].update(provider)
        save(self.state / "wrangler.json", config)

    def start(self):
        verify_bundle(self.artifact)
        self.log = (self.state / "workerd.log").open("ab")
        os.fchmod(self.log.fileno(), 0o600)
        log_start = self.log.tell()
        env = clean_environment(local=True)
        home = self.state / "home"
        home.mkdir(exist_ok=True)
        env["HOME"] = str(home)
        self.process = subprocess.Popen(
            ["node", str(wrangler_path()), "dev", "--config", str(self.state / "wrangler.json"),
             "--local", "--no-bundle", "--ip", "127.0.0.1", "--port", str(self.port),
             "--inspector-port", str(free_port()), "--persist-to", str(self.state / "storage"),
             "--show-interactive-dev-session=false"],
            cwd=self.state, env=env, stdout=self.log, stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            require(self.process.poll() is None, f"workerd exited; inspect private {self.state / 'workerd.log'}")
            # A healthy unrelated process on the chosen port is not our Worker.
            # Only this launch's log suffix can establish that we own the listener.
            with (self.state / "workerd.log").open("rb") as startup_log:
                startup_log.seek(log_start)
                listening = f"Ready on {self.base}".encode() in startup_log.read(2 * 1024 * 1024)
            if not listening:
                time.sleep(0.2)
                continue
            try:
                runtime = runtime_status(self.base, self.admin)
                require(not self.activated or runtime["maintenance"] is False,
                        "local Worker lost its active runtime state across restart")
                if not self.activated:
                    require(runtime["maintenance"] is True, "new private Worker must start paused")
                    fingerprint = request(self.base, "/internal/migration/fingerprint", admin=self.admin)
                    require(re.fullmatch(r"[0-9a-f]{64}", fingerprint.get("sha256", "")),
                            "local Worker omitted its authoritative fingerprint")
                    request(self.base, "/internal/runtime", method="POST", admin=self.admin,
                            body={"enabled": True, "expectedFingerprint": fingerprint["sha256"]})
                    self.activated = True
                    require(runtime_status(self.base, self.admin)["maintenance"] is False,
                            "local Worker did not activate")
                if request(self.base, "/readyz").get("status") == "ready":
                    return self
            except (OSError, ValueError, OperationError):
                pass
            time.sleep(0.2)
        raise OperationError(f"workerd readiness deadline exceeded; inspect private {self.state / 'workerd.log'}")

    def stop(self):
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait(timeout=5)
        if self.log:
            self.log.close()


def runtime_status(base, admin):
    state = request(base, "/internal/runtime", admin=admin)
    require(isinstance(state, dict) and type(state.get("maintenance")) is bool,
            "Worker omitted its durable runtime status")
    return state


def public_assets(base):
    require(request(base, "/healthz").get("status") == "ok", "unexpected /healthz status")
    for route in ("/manifest.webmanifest", "/favicon.png", "/static/app.js"):
        request(base, route)


def public_smoke(base):
    public_assets(base)
    require(request(base, "/readyz").get("status") == "ready", "unexpected /readyz status")
    for route in ("/", "/v1/openapi.json"):
        request(base, route)
    request(base, "/v1/accounts/anonymous/sources/anonymous/generation-jobs", method="POST", expected=(401,))


def runtime_proof(base, admin, *, maintenance=None):
    state = runtime_status(base, admin)
    if maintenance is not None:
        require(state["maintenance"] is maintenance, "Worker runtime state changed unexpectedly")
    if state["maintenance"]:
        public_assets(base)
        request(base, "/readyz", expected=(503,))
        request(base, "/v1/accounts/anonymous/sources/anonymous/generation-jobs",
                method="POST", expected=(503,))
    else:
        public_smoke(base)
    require(runtime_status(base, admin)["maintenance"] is state["maintenance"],
            "Worker runtime state changed during verification")
    return {"maintenance": state["maintenance"], "readiness": "paused" if state["maintenance"] else "ready",
            "public_smoke": "not-run-paused" if state["maintenance"] else "passed"}


class LoopbackTransport:
    """External HTTP fixtures only; never model-quality or real mail evidence."""
    SOURCE = "Mitochondria generate ATP through cellular respiration."

    def __enter__(self):
        self.redirect = False
        self.redirect_followed = False
        owner = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *_args):
                pass

            def respond(self, status, body, location=None):
                payload = encoded(body)
                self.send_response(status)
                self.send_header("content-type", "application/json")
                self.send_header("content-length", str(len(payload)))
                if location:
                    self.send_header("location", location)
                self.end_headers()
                self.wfile.write(payload)

            def do_GET(self):
                owner.redirect_followed = True
                self.respond(404, {})

            def do_POST(self):
                length = int(self.headers.get("content-length", "0"))
                if not 0 < length <= 512 * 1024:
                    self.respond(413, {})
                    return
                json.loads(self.rfile.read(length))
                if self.path not in ("/chat/completions", "/emails"):
                    owner.redirect_followed = True
                    self.respond(404, {})
                    return
                if self.headers.get("authorization") != "Bearer isolated-transport":
                    self.respond(401, {})
                    return
                if owner.redirect:
                    self.respond(302, {}, owner.origin + "/redirect-target")
                    return
                if self.path == "/emails":
                    self.respond(200, {"id": "isolated-mail-acceptance"})
                    return
                drafts = {"learning_intent": "fact_recall", "drafts": [{
                    "concept": "Cell energy", "question": "Which organelle produces ATP through cellular respiration?",
                    "answer": "Mitochondria", "evidence_quote": owner.SOURCE,
                    "distractors": ["Chloroplast", "Nucleus"], "activity_kind": "quiz",
                    "activity_stage": "recognition", "worked_solution": "",
                }]}
                self.respond(200, {
                    "choices": [{"finish_reason": "stop", "message": {"content": json.dumps(drafts)}}],
                    "usage": {"prompt_tokens": 100, "completion_tokens": 80, "cost": 0.0001},
                })

        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.origin = f"http://127.0.0.1:{self.server.server_port}"
        self.thread = Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        return self

    def __exit__(self, *_args):
        self.server.shutdown()
        self.server.server_close()
        self.thread.join(timeout=5)
        require(not self.thread.is_alive(), "loopback transport did not stop")


def wait_generation(local, prefix, job_id, token, expected_status="succeeded"):
    deadline = time.monotonic() + 60
    while True:
        job = request(local.base, prefix + f"/generation-jobs/{job_id}", token=token)
        if job["status"] not in ("queued", "running", "retry"):
            require(job["status"] == expected_status,
                    f"generation finished {job['status']}, expected {expected_status}")
            return job
        require(time.monotonic() < deadline, "generation alarm did not finish within 60 seconds")
        time.sleep(0.2)


def transport_smoke(local, prefix, token):
    with LoopbackTransport() as upstream:
        local.stop()
        config = load(local.state / "wrangler.json")
        config["vars"].update({
            "OPENROUTER_BASE_URL": upstream.origin, "OPENROUTER_API_KEY": "isolated-transport",
            "MEMORY_ENGINE_GENERATION_MODEL": "isolated-transport",
            "RESEND_API_URL": upstream.origin, "RESEND_API_KEY": "isolated-transport",
            "MEMORY_ENGINE_MAIL_MODE": "resend", "MEMORY_ENGINE_AUTH_EXPOSE_DEBUG_LINKS": "false",
            "MEMORY_ENGINE_PUBLIC_BASE_URL": "https://scry.example.test",
        })
        (local.state / "wrangler.json").write_bytes(encoded(config) + b"\n")
        local.start()
        prior_deliveries = {
            row["delivery_key"]
            for row in request(local.base, "/internal/mail/receipts", admin=local.admin)["receipts"]
        }
        for redirect, expected_status in ((False, "succeeded"), (True, "failed")):
            upstream.redirect = redirect
            source = request(local.base, prefix + "/sources", method="POST", token=token, expected=(201,),
                             body={"title": "Worker Fetch boundary", "body": upstream.SOURCE, "permission": "model-eligible"})
            queued = request(local.base, prefix + f"/sources/{source['sourceId']}/generation-jobs",
                             method="POST", token=token, expected=(202,))
            job = wait_generation(local, prefix, queued["id"], token, expected_status)
            if not redirect:
                generated = request(local.base, prefix + "/review/next", method="POST", token=token)
                require(generated.get("current") is not None and
                        any(draft["answer"] == "Mitochondria" and draft["approved"]
                            and draft["learnerDecision"] is None for draft in generated["drafts"]),
                        "validated Worker Fetch material was not automatically ready for review")
                require(job["cardCount"] > 0, "completed provider generation did not publish review cards")
            form = urllib.parse.urlencode({"email": local.email}).encode()
            sign_in = urllib.request.Request(local.base + "/app/account", data=form, method="POST",
                                             headers={"content-type": "application/x-www-form-urlencoded"})
            try:
                response = urllib.request.build_opener(NoRedirect()).open(sign_in, timeout=20)
            except urllib.error.HTTPError as error:
                response = error
            with response:
                require(len(response.read(128 * 1024 + 1)) <= 128 * 1024,
                        "mail response exceeded its HTML bound")
                require(response.status == (503 if redirect else 200),
                        f"mail transport returned HTTP {response.status} in redirect={redirect} case")
            mail = request(local.base, "/internal/mail/receipts", admin=local.admin)
            require(mail["deliveryVerified"] is False and mail["readVerified"] is False,
                    "provider acceptance was mislabeled as mailbox delivery or reading")
            states = {row["state"] for row in mail["receipts"] if row["delivery_key"] not in prior_deliveries}
            require(states == ({"accepted", "unknown"} if redirect else {"accepted"}),
                    "mail receipts did not distinguish accepted and uncertain sends")
            require(not upstream.redirect_followed, "Worker followed a model or mail redirect")


def browser_open(client, url, form=None):
    data = None if form is None else urllib.parse.urlencode(form).encode()
    req = urllib.request.Request(url, data=data)
    try:
        return client.open(req, timeout=10)
    except urllib.error.HTTPError as error:
        return error


def browser_identity_smoke(local, other_email):
    class NoFollow(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    client = urllib.request.build_opener(
        NoFollow(), urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    with browser_open(client, local.base + "/app/account", {"email": local.email}) as response:
        require(response.status == 200, "local browser sign-in request failed")
        link = re.search(r'href="([^"]*/app/login/verify\?[^"]+)"', response.read().decode())
        require(link is not None, "explicit local outbox omitted the verification link")
    verify_url = urllib.parse.urljoin(local.base, html.unescape(link[1]))
    require(verify_url.startswith(local.base + "/app/login/verify?"), "local verification escaped its origin")
    with browser_open(client, verify_url) as response:
        require(response.status == 303, "browser magic link did not establish a session")
    with browser_open(client, local.base + "/app/library") as response:
        require(response.status == 200, "browser session did not open Library")
        csrf = re.search(r'name="csrfToken" value="([^"]+)"', response.read().decode())
        require(csrf is not None, "authenticated Library omitted its form token")
    with browser_open(client, local.base + "/app/save-account",
                      {"csrfToken": html.unescape(csrf[1]), "email": other_email}) as response:
        require(response.status in (400, 404), "a learner could preclaim another invitee's identity")
    return client


def stream_pause_smoke(local, client):
    with browser_open(client, local.base + "/app/jobs/events") as response:
        require(response.status == 200 and response.readline(), "authenticated job stream did not open")
        fingerprint = request(local.base, "/internal/migration/fingerprint", admin=local.admin)
        paused = request(local.base, "/internal/runtime", method="POST", admin=local.admin,
                         body={"enabled": False, "expectedFingerprint": fingerprint["sha256"]})
        require(paused["maintenance"] is True, "traffic did not pause")
        started = time.monotonic()
        response.read()
        require(time.monotonic() - started < 5, "job stream remained active after traffic paused")
    health = request(local.base, "/statusz", expected=(503,))
    require(health["status"] == "degraded" and health["maintenance"] is True,
            "public health witness reported a paused runtime as healthy")
    after = request(local.base, "/internal/migration/fingerprint", admin=local.admin)
    require(after["sha256"] == fingerprint["sha256"], "completed pause allowed durable learner writes")


def recovery_smoke(local, fingerprint):
    admin_env = local.state / "recovery-admin.env"
    with admin_env.open("x") as stream:
        os.fchmod(stream.fileno(), 0o600)
        stream.write(f"MEMORY_ENGINE_ADMIN_TOKEN={local.admin}\n")
    backup = local.state / "backup-receipt.json"
    retrieved = local.state / "retrieved-backup.json"
    commands = [
        ["backup", "--target", "app", "--receipt", backup],
        ["retrieve", "--target", "app", "--receipt", backup, "--output", retrieved],
        ["restore", "--target", "restore-isolated-smoke", "--receipt", backup],
    ]
    for command in commands:
        result = json.loads(run([sys.executable, REPO / "scripts/scry-cloudflare-data", *command,
                                 "--base", local.base, "--admin-env", admin_env]).stdout)
    require(result["fingerprint"]["sha256"] == fingerprint["sha256"],
            "R2 restore changed the authoritative learning state")
    health = request(local.base, "/statusz")
    require(health["schema"] == "memory_engine.runtime_health.v1"
            and health["status"] == "healthy" and health["maintenance"] is False
            and type(health["backupAgeMs"]) is int and 0 <= health["backupAgeMs"] <= 90_000_000,
            "public health witness did not observe the completed R2 backup")


def smoke_bundle(artifact, receipt):
    require(not Path(receipt).exists(), "verification receipt already exists")
    artifact = Path(artifact).resolve()
    manifest = verify_bundle(artifact)
    with tempfile.TemporaryDirectory(prefix="scry-workerd-smoke-") as temporary:
        other_email = "isolation@example.test"
        local = LocalWorker(artifact, Path(temporary) / "runtime", additional_emails=(other_email,))
        try:
            local.start()
            public_smoke(local.base)
            session = request(local.base, "/v1/service-sessions", method="POST",
                              body={"email": local.email}, admin=local.admin, expected=(201,))
            token = session["sessionToken"]
            account = session["accountId"]
            prefix = f"/v1/accounts/{account}"
            source = request(local.base, prefix + "/sources", method="POST", token=token, expected=(201,),
                             body={"title": "Isolated Worker proof", "permission": "local-only",
                                   "body": "Concept: NATO letter A\nActivity: quiz\nStage: recognition-3\nQuestion: What is the NATO word for A?\nAnswer: ALFA\nDistractors: ABLE, AMBER\nReference: The NATO word for A is ALFA."})
            source_id = source["sourceId"]
            queued = request(local.base, prefix + f"/sources/{source_id}/generation-jobs",
                             method="POST", token=token, expected=(202,))
            job_id = queued["id"]
            job = wait_generation(local, prefix, job_id, token)
            require(job["cardCount"] > 0, "completed generation did not automatically publish review cards")
            generated = request(local.base, prefix + "/review/next", method="POST", token=token)
            require(generated["drafts"] and generated.get("current") is not None,
                    "validated generation was not ready for review without keep")
            require(all(draft["approved"] and draft["learnerDecision"] is None for draft in generated["drafts"]),
                    "automatic publication fabricated a learner decision or omitted enrollment")
            review_id = generated["current"]["reviewUnitId"]
            browser_client = browser_identity_smoke(local, other_email)
            other_session = request(local.base, "/v1/service-sessions", method="POST",
                                    body={"email": other_email}, admin=local.admin, expected=(201,))
            other_prefix = f"/v1/accounts/{other_session['accountId']}"
            request(local.base, other_prefix + "/sources", token=token, expected=(403,))
            request(local.base, prefix + "/sources", token=other_session["sessionToken"], expected=(403,))
            require(request(local.base, other_prefix + "/sources", token=other_session["sessionToken"])["sources"] == [],
                    "the second account observed the first account's source")
            request(local.base, prefix + f"/review/{review_id}/reveal", method="POST", token=token)
            local.stop()
            local.start()
            resumed = request(local.base, prefix + "/review/next", method="POST", token=token)
            require(resumed["current"]["reviewUnitId"] == review_id, "review/session did not survive workerd restart")
            payload = {"answer": "ALFA", "responseTimeMs": 1800, "idempotencyKey": "isolated-worker-proof"}
            route = prefix + f"/review/{review_id}/submit"
            submitted = request(local.base, route, method="POST", token=token, body=payload)
            require(submitted["current"]["grade"] == {"verdict": "revealed", "rating": 1, "isCorrect": False},
                    "assisted exposure did not survive restart or was graded as successful recall")
            require(submitted["current"]["feedback"]["itemHistory"]["correct"] == 0,
                    "assisted exposure counted as a correct recall")
            before_replay = request(local.base, "/internal/migration/fingerprint", admin=local.admin)
            local.stop()
            local.start()
            replayed = request(local.base, route, method="POST", token=token, body=payload)
            require(replayed["current"]["grade"] == submitted["current"]["grade"], "durable answer replay changed its grade")
            fingerprint = request(local.base, "/internal/migration/fingerprint", admin=local.admin)
            learning_tables = {"memory_engine_attempts", "memory_engine_schedules",
                               "memory_engine_applied_reviews", "memory_engine_review_exposures"}
            before_learning = {row["name"]: row for row in before_replay["tables"] if row["name"] in learning_tables}
            after_learning = {row["name"]: row for row in fingerprint["tables"] if row["name"] in learning_tables}
            require(set(before_learning) == learning_tables and before_learning == after_learning,
                    "answer replay changed durable attempts, schedules, exposures, or receipts")
            for review_route, expected in ((f"/accounts/{account}/review/next", (405,)),
                                           (prefix + "/review/next", (200,))):
                for method in ("GET", "HEAD"):
                    request(local.base, review_route, method=method, token=token, expected=expected)
                    held = request(local.base, prefix + "/review/next", token=token)
                    require(held["current"] == replayed["current"],
                            f"{method} {review_route} consumed or changed the held graded feedback")
            continued = request(local.base, prefix + "/review/next", method="POST", token=token)
            require(continued.get("current") is None or continued["current"].get("grade") is None,
                    "explicit review advancement retained the held graded feedback")
            reopened = request(local.base, prefix + "/review/next", token=token)
            require(reopened["current"] == continued["current"],
                    "opening review after Continue restored the consumed graded feedback")
            transport_smoke(local, other_prefix, other_session["sessionToken"])
            fingerprint = request(local.base, "/internal/migration/fingerprint", admin=local.admin)
            require(fingerprint["accountCount"] == 2 and fingerprint["schemaVersions"] ==
                    [item["version"] for item in manifest["schema_ledger"]], "unexpected durable state fingerprint")
            recovery_smoke(local, fingerprint)
            stream_pause_smoke(local, browser_client)
        except Exception as error:
            diagnostic = Path(str(receipt) + ".workerd.log")
            diagnostic.parent.mkdir(parents=True, exist_ok=True)
            with diagnostic.open("xb") as stream:
                os.fchmod(stream.fileno(), 0o600)
                if (local.state / "workerd.log").exists():
                    stream.write((local.state / "workerd.log").read_bytes())
            reason = str(error) if isinstance(error, OperationError) else type(error).__name__
            raise OperationError(f"{reason}; private workerd log: {diagnostic}") from None
        finally:
            local.stop()
    save(receipt, {"schema": PROOF, "status": "passed", "bundle_sha256": digest(artifact / "manifest.json"),
                   "source_sha256": manifest["source_sha256"], "revision": manifest["revision"],
                   "wrangler": WRANGLER, "executed_at_ms": int(time.time() * 1000),
                   "checks": ["fingerprint-guarded-local-activation", "public-assets-and-readiness",
                              "anonymous-rejection", "admin-service-session",
                              "alarm-driven-local-only-generation", "automatic-publication-without-keep", "account-isolation", "durable-resume",
                              "runtime-survives-restart", "durable-assisted-grading", "durable-idempotent-replay",
                              "safe-review-methods-preserve-held-feedback", "explicit-review-advancement",
                              "worker-fetch-generation", "worker-mail-acceptance", "provider-redirect-rejection",
                              "schema-fingerprint", "r2-backup-retrieval-isolated-restore",
                              "browser-identity-isolation", "stream-pause-fence", "public-recovery-health"],
                   "mail_delivery": "local-http-fixture-only", "model_network": "external-models-disabled"})
    print(f"workerd proof={Path(receipt).resolve()} bundle_sha256={digest(artifact / 'manifest.json')}")


def reviewed_source(artifact, manifest):
    """No fixture, dirty-source, offline, host-install, or branch-guard bypass."""
    inventory = load(artifact / "source.json")
    require(digest(REPO / "scripts/scry-cloudflare") == inventory["scripts/scry-cloudflare"]["sha256"],
            "execute release tooling from the artifact's reviewed source revision")
    run(["git", "fetch", "origin", "master"], env=clean_environment())
    revision = manifest["revision"]
    require(re.fullmatch(r"[0-9a-f]{40}", revision), "invalid source revision")
    run(["git", "merge-base", "--is-ancestor", revision, "origin/master"])
    archive = subprocess.run(["git", "archive", "--format=tar", revision], cwd=REPO, capture_output=True, check=True).stdout
    expected = {}
    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
        for member in tar:
            if member.isfile():
                expected[member.name] = {"sha256": sha(tar.extractfile(member).read()),
                                         "mode": "100755" if member.mode & 0o100 else "100644"}
            elif member.issym():
                expected[member.name] = {"sha256": sha(os.fsencode(member.linkname)), "mode": "120000"}
            else:
                require(member.isdir(), "unsupported reviewed-source archive entry")
    require(expected == inventory, "artifact source differs from the reviewed Git revision")
    protection = json.loads(run(["gh", "api", f"repos/{REPOSITORY}/branches/master/protection"]).stdout)
    checks = protection.get("required_status_checks") or {}
    contexts = set(checks.get("contexts", [])) | {item["context"] for item in checks.get("checks", [])}
    require(protection.get("enforce_admins", {}).get("enabled") and "ci" in contexts,
            "master protection must enforce the ci gate, including administrators")
    pages = json.loads(run(["gh", "api", "--paginate", "--slurp",
                           f"repos/{REPOSITORY}/commits/{revision}/check-runs?per_page=100"]).stdout)
    runs = [item for page in pages for item in page["check_runs"]
            if item["name"] == "ci" and item.get("app", {}).get("slug") == "github-actions"]
    require(runs, "reviewed revision has no GitHub Actions ci result")
    latest = max(runs, key=lambda item: item["id"])
    require(latest["head_sha"] == revision and latest["status"] == "completed" and latest["conclusion"] == "success",
            "reviewed revision does not have a successful current ci result")
    return {"repository": REPOSITORY, "revision": revision, "ci_check_run_id": latest["id"]}


def verify_proof(artifact, path):
    proof = load(path)
    require(proof.get("schema") == PROOF and proof.get("status") == "passed"
            and proof.get("bundle_sha256") == digest(artifact / "manifest.json")
            and proof.get("wrangler") == WRANGLER, "local workerd proof does not match this exact artifact")
    return proof


def version_message(bundle_hash):
    return f"scry bundle sha256:{bundle_hash}"


def remote_version(config, environment, version, bundle_hash):
    require(re.fullmatch(r"[0-9a-f-]{36}", version), "invalid explicit Worker version")
    result = json.loads(wrangler(["versions", "view", version, "--json"], config, environment=environment).stdout)
    require(result["id"] == version and result.get("annotations", {}).get("workers/message") == version_message(bundle_hash),
            "Cloudflare version metadata does not match the verified bundle hash")
    return result


def active_version(config, environment):
    status = json.loads(wrangler(["deployments", "status", "--json"], config, environment=environment).stdout)
    versions = status["versions"]
    require(len(versions) == 1 and versions[0]["percentage"] == 100, "expected one explicit 100% Worker deployment")
    return versions[0]["version_id"]


def operation_receipt(path, environment):
    value = load(path)
    require(value.get("schema") == RECEIPT and value.get("environment") == environment
            and value.get("account_id") == ACCOUNT, "receipt belongs to another deployment environment")
    return value


def worker_origin(config, environment):
    base = config["env"][environment]["vars"]["MEMORY_ENGINE_PUBLIC_BASE_URL"].rstrip("/")
    require(base == f"https://{'scry-staging' if environment == 'staging' else 'scry'}.misty-step.workers.dev",
            "unexpected pre-cutover Worker origin")
    return base


def live_schema(base, manifest, admin):
    state = request(base, "/internal/migration/fingerprint", admin=admin)
    versions = [entry["version"] for entry in manifest["schema_ledger"]]
    require(state.get("schema") == "memory_engine.cloudflare_fingerprint.v1"
            and state.get("schemaVersions") == versions and state.get("storageSchemaVersion") == versions[-1],
            "live SQLite schema is not compatible; use isolated recovery/migration, never a blind code rollback")
    require(re.fullmatch(r"[0-9a-f]{64}", state.get("sha256", "")),
            "Worker omitted its authoritative fingerprint")
    return {"storage_schema_version": state["storageSchemaVersion"], "schema_versions": state["schemaVersions"],
            "fingerprint_sha256": state["sha256"]}


@contextmanager
def deployment_lock():
    """Serialize this operator's Scry mutations across worktrees and environments."""
    directory = Path.home() / ".cache/scry-release"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(directory / f"{ACCOUNT}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "a") as lock:
        info = os.fstat(lock.fileno())
        require(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()
                and stat.S_IMODE(info.st_mode) == 0o600, "release lock must be a private owner-owned file")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise OperationError("another Scry release/traffic operation holds the operator lock") from None
        yield


@deployment_lock()
def deploy_operation(args):
    if args.command != "deploy":
        return _deploy_operation(args)
    root = Path(args.out).resolve()
    require(not root.exists(), "deployment output already exists; inspect its receipts, never blindly retry")
    root.mkdir(parents=True, mode=0o700)
    upload_receipt = root / "upload.json"
    promote_receipt = root / "promote.json"
    print(f"deploy environment={args.environment} upload_receipt={upload_receipt} promote_receipt={promote_receipt}; "
          "uploads then switches the active code version; does not enable paused traffic. "
          "Accept staging product behavior before a separate production invocation.", flush=True)
    # One operator lock covers both guarded operations. Each rechecks the explicit
    # current deployment and staging evidence; failure stops without retry or activation.
    _deploy_operation(argparse.Namespace(**{**vars(args), "command": "upload", "receipt": upload_receipt}))
    _deploy_operation(argparse.Namespace(**{**vars(args), "command": "promote", "receipt": promote_receipt,
                                           "version_receipt": upload_receipt}))


def _deploy_operation(args):
    artifact = Path(args.artifact).resolve()
    manifest = verify_bundle(artifact)
    proof = verify_proof(artifact, args.verification)
    receipt_path = Path(args.receipt).resolve()
    require(not receipt_path.exists(), "operation receipt already exists")
    admin_values = private_env(args.admin_env)
    require(admin_values.get("MEMORY_ENGINE_ADMIN_TOKEN"), "private admin env lacks MEMORY_ENGINE_ADMIN_TOKEN")
    if args.command == "bootstrap":
        require(args.secrets_file, "bootstrap requires an explicit private --secrets-file")
        initial_secrets = private_env(args.secrets_file)
        require(initial_secrets.get("MEMORY_ENGINE_ADMIN_TOKEN") == admin_values["MEMORY_ENGINE_ADMIN_TOKEN"],
                "bootstrap secrets and admin proof must use the same environment token")
    review = reviewed_source(artifact, manifest)
    environment = args.environment
    bundle_hash = digest(artifact / "manifest.json")
    config_data = load(artifact / "wrangler.json")
    worker_name = config_data["env"][environment]["name"]
    base = worker_origin(config_data, environment)
    admin = admin_values["MEMORY_ENGINE_ADMIN_TOKEN"]
    staging = None
    if environment == "production" and args.command in ("bootstrap", "upload", "promote"):
        require(args.staging_receipt, "production requires verified staging deployment of identical bytes")
        staging = operation_receipt(args.staging_receipt, "staging")
        staged_runtime = staging.get("runtime_proof", {})
        require(staging.get("status") == "verified" and staging["bundle_sha256"] == bundle_hash
                and staged_runtime.get("maintenance") is False and staged_runtime.get("readiness") == "ready"
                and staged_runtime.get("public_smoke") == "passed",
                "staging has not activated and passed public_smoke for this exact bundle/version")
        remote_version(artifact / "wrangler.json", "staging", staging["version_id"], bundle_hash)
        require(active_version(artifact / "wrangler.json", "staging") == staging["version_id"],
                "staging no longer deploys the version bound to its activation/public_smoke proof")
    result = {"schema": RECEIPT, "action": args.command, "environment": environment,
              "account_id": ACCOUNT, "worker": worker_name, "revision": manifest["revision"],
              "source_sha256": manifest["source_sha256"], "bundle_sha256": bundle_hash,
              "schema_sha256": manifest["schema_sha256"], "schema_ledger": manifest["schema_ledger"],
              "reviewed_source": review, "workerd_proof_sha256": digest(args.verification),
              "started_at_ms": int(time.time() * 1000), "status": "prepared"}
    if staging:
        result["staging_version_id"] = staging["version_id"]
        result["staging_receipt_sha256"] = digest(args.staging_receipt)
    # Record intent before a remote mutation. Never lose the version when later smoke fails.
    save(str(receipt_path) + ".intent.json", result)
    output = Path(str(receipt_path) + ".wrangler.ndjson")
    with output.open("xb") as stream:
        os.fchmod(stream.fileno(), 0o600)
    with tempfile.TemporaryDirectory(prefix="scry-worker-deploy-") as temporary:
        temporary = Path(temporary)
        copied = temporary / "bundle"
        shutil.copytree(artifact, copied)
        verify_bundle(copied)
        config = copied / "wrangler.json"
        try:
            if args.command == "bootstrap":
                absent = wrangler(["deployments", "status", "--json"], config, environment=environment,
                                  output=output, check=False)
                entries = [json.loads(line) for line in output.read_text().splitlines()] if output.exists() else []
                require(absent.returncode != 0 and any(entry.get("type") == "command-failed" and entry.get("code") == 10007 for entry in entries),
                        "bootstrap requires positively identified missing Worker (Cloudflare 10007), not an existing deployment or auth failure")
                output.write_bytes(b"")
                wrangler(["deploy", "--no-bundle", "--strict", "--message", version_message(bundle_hash),
                          "--tag", f"{manifest['revision'][:12]}-{bundle_hash[:12]}",
                          "--secrets-file", str(Path(args.secrets_file).resolve())],
                         config, environment=environment, output=output)
                kind = "deploy"
            else:
                require(args.current, "an explicit --current deployment receipt is required")
                current = operation_receipt(args.current, environment)
                require(current.get("status") in ("verified", "failed-requires-inspection"),
                        "current receipt must verify a deployment or explicitly record its failure")
                require(current["schema_sha256"] == manifest["schema_sha256"],
                        "code promotion/rollback cannot cross SQLite schema definitions")
                require(active_version(config, environment) == current["version_id"], "live deployment changed; refresh the explicit current receipt")
                remote_version(config, environment, current["version_id"], current["bundle_sha256"])
                result["previous_version_id"] = current["version_id"]
                result["current_receipt_sha256"] = digest(args.current)
                result["outgoing_status"] = current["status"]
                # The control-plane identity and identical reviewed schema are
                # the rollback preflight. An unhealthy outgoing application must
                # not have to pass the probes that rollback is intended to repair.
                if args.command != "rollback":
                    # A failed post-deploy observation is recoverable only after
                    # the same live preflight succeeds; its receipt is not proof.
                    result["schema_proof"] = live_schema(base, manifest, admin)
                    result["runtime_proof"] = runtime_proof(base, admin)
                if args.command == "upload":
                    wrangler(["versions", "upload", "--no-bundle", "--strict", "--message", version_message(bundle_hash),
                              "--tag", f"{manifest['revision'][:12]}-{bundle_hash[:12]}"],
                             config, environment=environment, output=output)
                    kind = "version-upload"
                else:
                    require(args.version_receipt, "promotion/rollback requires an explicit --version-receipt")
                    target = operation_receipt(args.version_receipt, environment)
                    require(target["bundle_sha256"] == bundle_hash and target["schema_sha256"] == manifest["schema_sha256"],
                            "target version receipt does not match the artifact")
                    if args.command == "rollback":
                        require(target.get("status") == "verified" and target.get("action") in ("bootstrap", "promote", "rollback", "traffic"),
                                "rollback target must have previously passed deployed verification")
                    else:
                        require(target.get("action") == "upload" and target.get("status") == "uploaded",
                                "promote requires a verified uploaded version receipt")
                    remote_version(config, environment, target["version_id"], bundle_hash)
                    result["version_id"] = target["version_id"]
                    # Both directions name immutable versions; never implicit 'previous' or a rebuild.
                    require(active_version(config, environment) == current["version_id"],
                            "live deployment changed during preflight; refusing to overwrite it")
                    wrangler(["versions", "deploy", f"{target['version_id']}@100", "--yes",
                              "--message", f"scry {args.command} {bundle_hash}"],
                             config, environment=environment, output=output)
                    kind = "version-deploy"
            entries = [json.loads(line) for line in output.read_text().splitlines()]
            records = [entry for entry in entries if entry.get("type") == kind and entry.get("version") == 1]
            require(len(records) == 1, "Wrangler did not produce exactly one structured operation result")
            record = records[0]
            require(record["worker_name"] == worker_name, "Wrangler operated on an unexpected Worker")
            if kind != "version-deploy":
                result["version_id"] = record["version_id"]
            else:
                result["deployment_id"] = record["deployment_id"]
            remote_version(config, environment, result["version_id"], bundle_hash)
            if args.command == "upload":
                require(active_version(config, environment) == result["previous_version_id"], "upload unexpectedly changed the active deployment")
                result["status"] = "uploaded"
            else:
                require(active_version(config, environment) == result["version_id"], "requested version is not the active 100% deployment")
                maintenance = True if args.command == "bootstrap" else (
                    None if args.command == "rollback" else result["runtime_proof"]["maintenance"])
                result["schema_proof"] = live_schema(base, manifest, admin)
                result["runtime_proof"] = runtime_proof(base, admin, maintenance=maintenance)
                require(active_version(config, environment) == result["version_id"],
                        "live deployment changed during deployed verification")
                result["status"] = "verified"
            result["completed_at_ms"] = int(time.time() * 1000)
            save(receipt_path, result)
        except Exception:
            result["status"] = "failed-requires-inspection"
            # Recover any uploaded/deployed ID even if subsequent verification failed.
            if output.exists():
                for line in output.read_text().splitlines():
                    entry = json.loads(line)
                    if entry.get("type") in ("deploy", "version-upload") and entry.get("version_id"):
                        result["version_id"] = entry["version_id"]
            save(str(receipt_path) + ".failed.json", result)
            raise
    print(f"{args.command} environment={environment} version={result['version_id']} bundle_sha256={bundle_hash} receipt={receipt_path}")


@deployment_lock()
def traffic_operation(args):
    artifact = Path(args.artifact).resolve()
    manifest = verify_bundle(artifact)
    environment = args.environment
    bundle_hash = digest(artifact / "manifest.json")
    current = operation_receipt(args.current, environment)
    require(current.get("status") == "verified" and current.get("bundle_sha256") == bundle_hash
            and current.get("source_sha256") == manifest["source_sha256"]
            and current.get("schema_sha256") == manifest["schema_sha256"],
            "--current must verify this exact deployed artifact and schema")
    require(re.fullmatch(r"[0-9a-f]{64}", current.get("workerd_proof_sha256", "")),
            "current deployment omitted its workerd proof binding")
    require(re.fullmatch(r"[0-9a-f]{64}", args.expected_fingerprint),
            "--expected-fingerprint must be the reviewed authoritative SHA-256")
    require(environment != "production" or not args.enable or args.source_quiesced,
            "production activation requires --source-quiesced after the independently executed source writer barrier")
    receipt_path = Path(args.receipt).resolve()
    require(not receipt_path.exists(), "operation receipt already exists")
    values = private_env(args.admin_env)
    require(values.get("MEMORY_ENGINE_ADMIN_TOKEN"), "private admin env lacks MEMORY_ENGINE_ADMIN_TOKEN")
    admin = values["MEMORY_ENGINE_ADMIN_TOKEN"]
    config = artifact / "wrangler.json"
    config_data = load(config)
    base = worker_origin(config_data, environment)
    review = reviewed_source(artifact, manifest)
    version = current["version_id"]
    require(active_version(config, environment) == version,
            "live deployment changed; refresh the explicit current receipt")
    remote_version(config, environment, version, bundle_hash)
    result = {"schema": RECEIPT, "action": "traffic", "environment": environment,
              "account_id": ACCOUNT, "worker": config_data["env"][environment]["name"],
              "revision": manifest["revision"], "source_sha256": manifest["source_sha256"],
              "bundle_sha256": bundle_hash, "schema_sha256": manifest["schema_sha256"],
              "schema_ledger": manifest["schema_ledger"], "reviewed_source": review,
              "workerd_proof_sha256": current["workerd_proof_sha256"],
              "current_receipt_sha256": digest(args.current), "version_id": version,
              "enabled": args.enable, "expected_fingerprint": args.expected_fingerprint,
              "source_quiesced": args.source_quiesced, "runtime_mutation": "not-attempted",
              "started_at_ms": int(time.time() * 1000), "status": "prepared"}
    save(str(receipt_path) + ".intent.json", result)
    try:
        result["schema_proof"] = live_schema(base, manifest, admin)
        require(result["schema_proof"]["fingerprint_sha256"] == args.expected_fingerprint,
                "live state differs from --expected-fingerprint; review import/current-state readback before changing traffic")
        before = runtime_status(base, admin)
        result["previous_maintenance"] = before["maintenance"]
        require(active_version(config, environment) == version,
                "live deployment changed before the runtime mutation")
        if before["maintenance"] is args.enable:
            result["runtime_mutation"] = "requested"
            request(base, "/internal/runtime", method="POST", admin=admin,
                    body={"enabled": args.enable, "expectedFingerprint": args.expected_fingerprint})
            result["runtime_mutation"] = "applied"
        else:
            result["runtime_mutation"] = "not-needed"
        result["runtime_proof"] = runtime_proof(base, admin, maintenance=not args.enable)
        result["schema_proof"] = live_schema(base, manifest, admin)
        if not args.enable:
            require(result["schema_proof"]["fingerprint_sha256"] == args.expected_fingerprint,
                    "paused authoritative state changed across the runtime request")
        remote_version(config, environment, version, bundle_hash)
        require(active_version(config, environment) == version,
                "traffic operation changed or raced the immutable Worker deployment")
        result["status"] = "verified"
        result["completed_at_ms"] = int(time.time() * 1000)
        save(receipt_path, result)
    except Exception:
        result["status"] = "failed-requires-inspection"
        save(str(receipt_path) + ".failed.json", result)
        raise
    print(f"traffic environment={environment} enabled={str(args.enable).lower()} version={version} bundle_sha256={bundle_hash} receipt={receipt_path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("tools", help="install only the repository-pinned build dependencies")
    for name in ("build", "gate"):
        command = commands.add_parser(name)
        command.add_argument("--out", required=name == "build")
        command.add_argument("--revision", help="full Git revision; required only for a Dagger source without .git")
    command = commands.add_parser("smoke")
    command.add_argument("--artifact", required=True)
    command.add_argument("--receipt", required=True)
    command = commands.add_parser("dev", help="build fresh exact bytes and open a private local Worker")
    command.add_argument("--artifact", help="use these exact existing bytes instead of building")
    command.add_argument("--state", help="new private state directory retained after exit; never reused")
    command.add_argument("--port", type=int, default=0, help="loopback port; default: an available port")
    command.add_argument("--email", default="dev@example.test")
    command.add_argument("--provider-env",
                         help="explicit mode-0600 API key/model file; enables paid model calls for local captures")
    for name in ("bootstrap", "deploy", "upload", "promote", "rollback"):
        command = commands.add_parser(name, description=(
            "Upload and promote only the selected environment. Accept staging product behavior before "
            "a separate production invocation. Paused traffic is never enabled."
        ) if name == "deploy" else None)
        command.add_argument("--artifact", required=True)
        command.add_argument("--verification", required=True)
        command.add_argument("--environment", choices=("staging", "production"), required=True)
        if name == "deploy":
            command.add_argument("--out", required=True, help="new private directory for upload/promote receipts")
        else:
            command.add_argument("--receipt", required=True)
        command.add_argument("--admin-env", required=True, help="private mode0600 env with MEMORY_ENGINE_ADMIN_TOKEN")
        command.add_argument("--current", required=name == "deploy",
                             help="explicit current deployment receipt for this environment")
        if name != "deploy":
            command.add_argument("--version-receipt", help="explicit uploaded or previously verified target version")
        command.add_argument("--staging-receipt", help="same-byte staging receipt proving activation and passed public_smoke")
        if name != "deploy":
            command.add_argument("--secrets-file", help="bootstrap only: private literal KEY=value secrets")
    command = commands.add_parser("traffic", help="pause or activate the primary actor without changing Worker versions")
    command.add_argument("--environment", choices=("staging", "production"), required=True)
    command.add_argument("--artifact", required=True)
    command.add_argument("--current", required=True, help="verified current deployment/traffic receipt for this exact artifact")
    command.add_argument("--admin-env", required=True, help="private mode0600 env with MEMORY_ENGINE_ADMIN_TOKEN")
    command.add_argument("--expected-fingerprint", required=True, help="reviewed imported/current authoritative SHA-256")
    command.add_argument("--source-quiesced", action="store_true",
                         help="declare all old writers/senders independently stopped; required for production activation")
    command.add_argument("--receipt", required=True)
    intent = command.add_mutually_exclusive_group(required=True)
    intent.add_argument("--enable", action="store_true")
    intent.add_argument("--disable", dest="enable", action="store_false")
    args = parser.parse_args()
    if args.command == "tools":
        install_tools()
    elif args.command == "build":
        build_bundle(args.out, args.revision)
    elif args.command == "gate":
        if args.out:
            root = Path(args.out).resolve()
        else:
            parent = REPO / "target/cloudflare/gates"
            parent.mkdir(parents=True, exist_ok=True)
            root = Path(tempfile.mkdtemp(prefix="gate-", dir=parent)) / "proof"
        require(not root.exists(), "gate output already exists")
        artifact = build_bundle(root / "bundle", args.revision)
        smoke_bundle(artifact, root / "workerd-proof.json")
    elif args.command == "smoke":
        smoke_bundle(args.artifact, args.receipt)
    elif args.command == "dev":
        with tempfile.TemporaryDirectory(prefix="scry-workerd-dev-") as temporary:
            artifact = args.artifact or build_bundle(Path(temporary) / "bundle")
            local = LocalWorker(artifact, args.state or str(Path(temporary) / "runtime"), args.port, args.email,
                                provider_env=args.provider_env)
            try:
                local.start()
                provider_notice = (
                    "Live model calls are enabled by your explicit provider file. Captured text is sent to that model."
                    if args.provider_env else
                    "No live model credentials are loaded. Browser capture needs --provider-env for AI generation; "
                    "the API can generate explicit Question:/Answer: sources with permission local_only."
                )
                print(f"local Worker {local.base} state={local.state}\n"
                      f"Sign in at {local.base}/app/account with {local.email}; links appear only in the local outbox.\n"
                      f"{provider_notice}\nNo live mail or deployment credentials are loaded.",
                      flush=True)
                return local.process.wait()
            finally:
                local.stop()
    elif args.command == "traffic":
        traffic_operation(args)
    else:
        deploy_operation(args)
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OperationError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        # Do not print raw parsing/provider errors which can contain private payloads.
        message = str(error) if isinstance(error, OperationError) else type(error).__name__
        print(f"scry-cloudflare: {message}", file=sys.stderr)
        sys.exit(1)
