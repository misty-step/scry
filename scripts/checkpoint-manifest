#!/usr/bin/env python3
"""Bind a checkpoint verification manifest to the complete clean Git tree."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args])


def snapshot():
    if git("status", "--porcelain=v1", "-z", "--untracked-files=all"):
        raise ValueError("The verification checkout must be clean.")
    commit = git("rev-parse", "--verify", "HEAD").decode().strip()
    tree = git("rev-parse", "HEAD^{tree}").decode().strip()
    object_format = git("rev-parse", "--show-object-format").decode().strip()
    if object_format not in ("sha1", "sha256"):
        raise ValueError("Unsupported Git object format.")
    files = {}
    for record in git("ls-tree", "-r", "-z", "--full-tree", "HEAD").split(b"\0"):
        if not record:
            continue
        header, raw_path = record.split(b"\t", 1)
        mode, kind, expected_oid = header.decode().split()
        path = os.fsdecode(raw_path)
        p = Path(path)
        if p.is_absolute() or ".." in p.parts or kind != "blob" or mode not in ("100644", "100755", "120000"):
            raise ValueError(f"Unsupported tracked entry: {path}")
        if mode == "120000":
            if not p.is_symlink():
                raise ValueError(f"Tracked symlink changed: {path}")
            data = os.fsencode(os.readlink(p))
            detail = {"link": os.readlink(p)}
        else:
            if p.is_symlink() or not p.is_file():
                raise ValueError(f"Tracked file missing: {path}")
            executable = bool(p.stat().st_mode & 0o111)
            if executable != (mode == "100755"):
                raise ValueError(f"Tracked file mode changed: {path}")
            data = p.read_bytes()
            detail = {"sha256": hashlib.sha256(data).hexdigest(), "executable": executable}
        oid = hashlib.new(object_format, b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
        if oid != expected_oid:
            raise ValueError(f"Tracked Git blob changed: {path}")
        files[path] = detail
    if not files:
        raise ValueError("The Git tree is empty.")
    return {"version": 2, "commit": commit, "tree": tree, "files": files}


def main():
    if sys.argv[1:] == ["create"]:
        print(json.dumps(snapshot(), sort_keys=True, indent=2))
    elif len(sys.argv) == 4 and sys.argv[1] == "check":
        manifest = json.loads(Path(sys.argv[2]).read_text())
        actual = snapshot()
        if actual["commit"] != sys.argv[3] or manifest != actual:
            raise ValueError("Manifest or requested commit does not match the complete clean Git tree.")
        print(f"Verified complete Git tree {actual['tree']} ({len(actual['files'])} files and links) for {actual['commit']}.")
    else:
        raise ValueError("Usage: checkpoint-manifest create | check MANIFEST COMMIT")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
