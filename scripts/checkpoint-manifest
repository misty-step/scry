#!/usr/bin/env python3
"""Create or verify a source-bound manifest including tracked symlinks."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def entry(path):
    p = Path(path)
    if p.is_symlink():
        return {"link": os.readlink(p)}
    if not p.is_file():
        raise ValueError(f"Tracked file missing: {path}")
    return {"sha256": hashlib.sha256(p.read_bytes()).hexdigest(), "executable": bool(p.stat().st_mode & 0o111)}


def main():
    if sys.argv[1:] == ["create"]:
        if subprocess.check_output(["git", "status", "--porcelain", "--untracked-files=all"]).strip():
            raise ValueError("Commit or remove worktree changes before generating the manifest.")
        commit = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
        paths = subprocess.check_output(["git", "ls-files", "-z"]).decode().split("\0")[:-1]
        print(json.dumps({"version": 1, "commit": commit, "files": {p: entry(p) for p in paths}}, sort_keys=True, indent=2))
    elif len(sys.argv) == 4 and sys.argv[1] == "check":
        manifest = json.loads(Path(sys.argv[2]).read_text())
        if manifest.get("version") != 1 or manifest.get("commit") != sys.argv[3]:
            raise ValueError("Manifest does not identify the requested source commit.")
        files = manifest.get("files")
        if not isinstance(files, dict) or not files:
            raise ValueError("Manifest has no files.")
        for path, expected in files.items():
            if Path(path).is_absolute() or ".." in Path(path).parts or entry(path) != expected:
                raise ValueError(f"Source differs: {path}")
        print(f"Verified {len(files)} tracked files and links for {manifest['commit']}.")
    else:
        raise ValueError("Usage: checkpoint-manifest create | check MANIFEST COMMIT")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
