#!/bin/sh
# Explicit synthetic release evidence; this is not invoked by the existing CI.
set -eu
: "${SCRY_CHECKPOINT_OLD_WORKER:?Set SCRY_CHECKPOINT_OLD_WORKER to the verified previous production Worker directory}"
: "${SCRY_CHECKPOINT_SOURCE_SHA:?Set SCRY_CHECKPOINT_SOURCE_SHA to the exact candidate commit}"
: "${SCRY_CHECKPOINT_SOURCE_MANIFEST:?Set SCRY_CHECKPOINT_SOURCE_MANIFEST to the complete source hash manifest}"
case "$SCRY_CHECKPOINT_SOURCE_SHA" in *[!0-9a-f]*|'') echo 'Invalid source commit' >&2; exit 1;; esac
[ "${#SCRY_CHECKPOINT_SOURCE_SHA}" -eq 40 ] || { echo 'Invalid source commit' >&2; exit 1; }
printf 'Candidate commit: %s\n' "$SCRY_CHECKPOINT_SOURCE_SHA"
python3 scripts/checkpoint-manifest check "$SCRY_CHECKPOINT_SOURCE_MANIFEST" "$SCRY_CHECKPOINT_SOURCE_SHA"
test -s "$SCRY_CHECKPOINT_OLD_WORKER/index.js"
test -s "$SCRY_CHECKPOINT_OLD_WORKER/index_bg.wasm"
test -s build/index.js
test -s build/index_bg.wasm
test -s target/debug/scry
sha256sum build/index.js build/index_bg.wasm target/debug/scry "$SCRY_CHECKPOINT_OLD_WORKER/index.js" "$SCRY_CHECKPOINT_OLD_WORKER/index_bg.wasm"
checkpoint_fixture_dir=$(mktemp -d "${TMPDIR:-/tmp}/scry-checkpoint-compat.XXXXXXXX")
trap 'rm -rf "$checkpoint_fixture_dir"' EXIT HUP INT TERM
export SCRY_CHECKPOINT_FIXTURE_DIR="$checkpoint_fixture_dir"
printf '%s\n' 'Generating synthetic saved and cleared checkpoint fixtures'
cargo test --locked --test checkpoint_contract export_synthetic_compatibility_fixtures_when_requested -- --ignored
printf '%s\n' 'Checking exact previous Worker and compatible isolated restore'
node --test qa/checkpoint-old-worker.test.mjs qa/checkpoint-recovery.test.mjs qa/checkpoint-cli-loss.test.mjs
