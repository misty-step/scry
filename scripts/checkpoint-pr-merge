#!/usr/bin/env python3
"""Require the authenticated PR merge revision and its exact ordered parents."""
import re
import subprocess
import sys


def main():
    if len(sys.argv) != 4 or any(not re.fullmatch(r'[0-9a-f]{40}', s) for s in sys.argv[1:]):
        raise ValueError('Usage: checkpoint-pr-merge MERGE_COMMIT BASE_COMMIT PR_HEAD_COMMIT')
    merge, base, head = sys.argv[1:]
    actual = subprocess.check_output(['git', 'rev-parse', '--verify', 'HEAD'], text=True).strip()
    parents = subprocess.check_output(['git', 'rev-list', '--parents', '-n', '1', merge], text=True).split()
    if actual != merge or parents != [merge, base, head]:
        raise ValueError('Checkout is not the stated PR merge commit with the exact base and head parents.')
    print(f'Verified PR merge {merge}, base {base}, head {head}.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
