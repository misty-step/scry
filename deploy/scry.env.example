# COPY, fill real values privately, then pass that private file to install.sh.
# This is systemd EnvironmentFile syntax, NOT shell: no export, substitutions,
# backticks, or sourced commands. Quote values as systemd requires. Never commit
# the completed file or put credentials on a command line. Keep an independently
# recoverable private copy outside the VM. Blank required production values fail
# closed; these are not invented working credentials or provider endpoints.
# Installed location: /etc/scry/scry.env (root:root, 0600).

SCRY_MODE=production
# Exact stable exe owner UserID, not an email or an unverified request header.
SCRY_OWNER_ID=
# At least 32 unpredictable characters. Generate privately; never print to logs.
SCRY_SECRET=
# Actual approved private HTTPS application origin, without a trailing path.
SCRY_BASE_URL=
# Optional comma-separated exact alternate hosts. Reads redirect to BaseURL;
# mutations are rejected, never forwarded or accepted on another origin.
SCRY_REDIRECT_HOSTS=
# Comma-separated exact IPs of the proven exe ingress, not public CIDRs.
# Do not guess these values: observe the actual trusted proxy connection first.
SCRY_TRUSTED_PROXY_IPS=

# The service explicitly fixes these paths/address via CLI flags. There is one
# writing application instance. Mutable files never live inside a release.
SCRY_DB=/var/lib/scry/scry.sqlite
SCRY_ADDR=127.0.0.1:8080

# Generation is unavailable until a REAL explicit model and endpoint are set.
# An exe integration may inject provider authorization without a VM-held key.
# Do not enable an integration or model in an isolated restore rehearsal.
SCRY_MODEL_ENDPOINT=
SCRY_MODEL_API_KEY=
SCRY_MODEL=
SCRY_MODEL_PROVIDER=
SCRY_GENERATION_DAILY_BUDGET_MICROS=1000000
SCRY_GENERATION_RESERVATION_MICROS=200000

SCRY_BACKUP_DIR=/var/lib/scry/backups
SCRY_BACKUP_INTERVAL=24h
# Only recognized complete LOCAL archives are pruned. Newest is preserved;
# corrupt/unknown/interrupted files are retained for explicit inspection.
SCRY_BACKUP_KEEP=30
# Private PUT/GET object PREFIX, without a query, fragment, or inline password.
# Each unique scry-<timestamp>-<random>.scry-backup.zip key is appended by Scry.
# Use an approved HTTPS append-only R2 gateway or explicit private exe signing
# integration. Ordinary Cloudflare bearer API auth does not sign S3 requests.
# HTTP is allowed only for private IPs, loopback, or *.int.exe.xyz integrations.
# No redirects are followed. Remote=true requires exact checksum GET readback.
# Configure the off-VM sink's privacy/retention separately: Scry never sends
# DELETE, never shortens remote retention, and cannot infer a provider policy.
SCRY_BACKUP_REMOTE_URL=
# Narrow append/read object token only; never a Cloudflare management credential.
# Leave empty only when the explicit private integration supplies authorization.
SCRY_BACKUP_REMOTE_TOKEN=
