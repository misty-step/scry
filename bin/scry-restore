#!/usr/bin/env python3
"""Restore a Scry dump into an isolated PG16 database. Never targets live `scry`."""
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile

CANDIDATES = (
    Path("/usr/local/lib/scry"),
    Path(__file__).resolve().parent.parent / "scripts/lib",
)
for candidate in CANDIDATES:
    if (candidate / "scry_ops.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from scry_ops import IsolatedPostgres, OperationError, digest, private_env, run  # noqa: E402

ENV_FILE = Path(os.environ.get("SCRY_BACKUP_ENV_FILE", "/etc/public-apps/scry-backup.env"))


def decrypt(cipher, passphrase, dest):
    run(
        [
            "gpg",
            "--batch",
            "--yes",
            "--pinentry-mode",
            "loopback",
            "--passphrase-fd",
            "0",
            "--decrypt",
            "--output",
            str(dest),
            str(cipher),
        ],
        input=passphrase.encode(),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def fetch_offhost(work):
    values = private_env(ENV_FILE, owner=None if os.environ.get("SCRY_ENV_OWNER_SELF") == "1" else 0)
    for key in ("SCRY_BACKUP_SPACES_BUCKET", "SCRY_BACKUP_SPACES_KEY", "SCRY_BACKUP_SPACES_SECRET", "SCRY_BACKUP_PASSPHRASE"):
        if not values.get(key):
            raise OperationError("off-host backup credentials are not provisioned")
    cipher = work / "latest.dump.gpg"
    env = os.environ.copy()
    env.update(
        ENDPOINT=f"https://{values.get('SCRY_BACKUP_REGION', 'nyc3')}.digitaloceanspaces.com",
        BUCKET=values["SCRY_BACKUP_SPACES_BUCKET"],
        AWS_ACCESS_KEY_ID=values["SCRY_BACKUP_SPACES_KEY"],
        AWS_SECRET_ACCESS_KEY=values["SCRY_BACKUP_SPACES_SECRET"],
        ARTIFACT=str(cipher),
        SCRY_BACKUP_REGION=values.get("SCRY_BACKUP_REGION", "nyc3"),
    )
    try:
        result = run(
            [
                "python3",
                "-c",
                "import os, sys, boto3\n"
                "from botocore.client import Config\n"
                "s3=boto3.client('s3', endpoint_url=os.environ['ENDPOINT'], region_name=os.environ['SCRY_BACKUP_REGION'], aws_access_key_id=os.environ['AWS_ACCESS_KEY_ID'], aws_secret_access_key=os.environ['AWS_SECRET_ACCESS_KEY'], config=Config(signature_version='s3v4'))\n"
                "objs=s3.list_objects_v2(Bucket=os.environ['BUCKET'], Prefix='scry/').get('Contents') or []\n"
                "if not objs:\n"
                "    sys.exit(2)\n"
                "latest=max(objs, key=lambda item: item['LastModified'])\n"
                "s3.download_file(os.environ['BUCKET'], latest['Key'], os.environ['ARTIFACT'])\n",
            ],
            env=env,
        )
    except OperationError as error:
        raise OperationError("off-host fetch failed") from error
    if not cipher.is_file():
        raise OperationError("off-host fetch produced no ciphertext")
    plain = work / "latest.dump"
    decrypt(cipher, values["SCRY_BACKUP_PASSPHRASE"], plain)
    cipher.unlink(missing_ok=True)
    return plain


def restore_isolated(dump, state):
    dump = Path(dump)
    if not dump.is_file() or dump.stat().st_size < 1:
        raise OperationError("restore dump is missing or empty")
    postgres = IsolatedPostgres(state, bindir=os.environ.get("SCRY_PG_BINDIR"))
    postgres.start()
    try:
        postgres.command(
            "pg_restore",
            "--no-owner",
            "--role=scry",
            "-d",
            "scry",
            str(dump),
            stdout=subprocess.DEVNULL,
        )
        listing = postgres.command(
            "psql",
            "-Atc",
            "SELECT COALESCE(MAX(version),0) FROM memory_engine_schema_migrations;",
            capture_output=True,
            text=True,
        )
        version = listing.stdout.strip()
        print(f"isolated restore ok schema={version} dump_sha256={digest(dump)} state={state}")
        return postgres
    except Exception:
        postgres.stop()
        raise


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", help="local custom-format dump")
    parser.add_argument("--offhost", action="store_true")
    parser.add_argument("--state", required=True)
    parser.add_argument("--keep", action="store_true", help="leave the isolated cluster running")
    args = parser.parse_args(argv)
    work = None
    postgres = None
    try:
        if args.offhost and args.input:
            raise OperationError("choose --input or --offhost, not both")
        if not args.offhost and not args.input:
            raise OperationError("restore requires --input or --offhost")
        state = Path(args.state)
        if state.exists():
            raise OperationError("isolated restore state already exists")
        dump = Path(args.input) if args.input else None
        if args.offhost:
            work = Path(tempfile.mkdtemp(prefix="scry-restore-"))
            os.chmod(work, 0o700)
            dump = fetch_offhost(work)
        postgres = restore_isolated(dump, state)
        if not args.keep:
            postgres.stop()
        return 0
    except OperationError as error:
        print(f"scry-restore: {error}", file=sys.stderr)
        return 1
    finally:
        if work is not None and work.exists():
            for leftover in work.glob("*"):
                leftover.unlink(missing_ok=True)
            work.rmdir()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
